/**
 * @file secrets.h.example
 * @brief M5Stack本体がアクセスポイントモードとして動作する際のAP認証情報（SSID/パスワード）テンプレートファイル
 *
 * このファイルをsecrets.hにリネームし、AP_SSID・AP_PASSWORDの値を書き換えてください
 * secrets.h自体はGit管理外（.gitignore対象）のため、リポジトリには含まれません
 * 
 * @note AP_PASSWORDの制約（WPA2-PSK規格・ESP32仕様）：
 * ・8〜63文字（半角英数字・記号）
 * ・「%」は既知の不具合報告があるため使用を避けること
 */

#ifndef SECRETS_H                               // インクルードガード（二重定義防止）
#define SECRETS_H

/**
 * @def AP_SSID
 * @brief APのSSID（WiFi.softAP()に渡す値）
 * @note AP_SSIDの制約：
 * ・1～23文字
 * 　AP接続案内画面に表示するため、画面幅に収まる範囲である23文字に制限している
 * 　（802.11規格上は32バイトまでだが、Arduinoコア側が終端ヌル文字を含める前提の実装のため実質31文字が上限）
 * ・組み込みフォントの都合により、非ASCII文字は画面に正しく表示されない
 */
#define AP_SSID     "M5Stack-AP"

/**
 * @def AP_PASSWORD
 * @brief APのパスワード
 */
#define AP_PASSWORD "your_password_here"

/**
 * @brief SSID・パスワードの文字数チェック
 *
 * 書き換えミス（長すぎる／短すぎる／空文字）をビルド時に検知する
 * ・SSID     ：802.11規格上は32バイト上限だが、Arduinoコア側が終端ヌル文字を含める前提の実装になっているため31文字が上限。
 *              ただし、画面設計上23文字を超過すると画面からはみ出してしまうため、23文字を上限とする
 * ・パスワード：WPA2-PSK規格上8～63文字。8文字未満の場合、パスワードが適用されないままAPが起動する
 *              （WiFi.softAP()の戻り値では検知できない）という報告があるため、ビルド時に弾く
 */
static_assert(sizeof(AP_SSID) - 1 >= 1, "AP_SSID must not be empty (ESP32 requirement)");
static_assert(sizeof(AP_SSID) - 1 <= 23, "AP_SSID must be 23 characters or fewer (limited by the setup screen width)");
static_assert(sizeof(AP_PASSWORD) - 1 >= 8, "AP_PASSWORD must be at least 8 characters (ESP32 requirement)");
static_assert(sizeof(AP_PASSWORD) - 1 <= 63, "AP_PASSWORD must be 63 characters or fewer (WPA2-PSK requirement)");

#endif