/**
 * secrets.h.example
 * このファイルをsecrets.hにリネームし、AP_SSID・AP_PASSWORDの値を書き換えてください
 * secrets.h自体はGit管理外（.gitignore対象）のため、リポジトリには含まれません
 * 
 * AP_PASSWORDの制約（WPA2-PSK規格・ESP32仕様）：
 * ・8〜63文字（半角英数字・記号）
 * ・「%」は既知の不具合報告があるため使用を避けること
 */

#ifndef SECRETS_H                               // インクルードガード（二重定義防止）
#define SECRETS_H

#define AP_SSID     "M5Stack-AP"
#define AP_PASSWORD "your_password_here"

// ESP32のWiFi.softAP()仕様上、パスワードは8文字以上が必須
// 書き換えミス（短すぎる／空文字）をビルド時に検知する
static_assert(sizeof(AP_PASSWORD) - 1 >= 8, "AP_PASSWORD must be at least 8 characters (ESP32 requirement)");

#endif